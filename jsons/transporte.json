        {
          "instance_id": "FOLHA_DOC003074_SENT009::transporte::1",
          "sent_ID": "FOLHA_DOC003074_SENT009",
          "text": "Os criminosos aproveitaram aglomeração em torno de promotores da empresa DHL, de transportes, que distribuía uma espécie de luva com o formato de uma mão amarela grande.",
          "arguments_annotated": true,
