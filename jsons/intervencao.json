        {
          "instance_id": "FOLHA_DOC003092_SENT016::intervenção::1",
          "sent_ID": "FOLHA_DOC003092_SENT016",
          "text": "Ele afirmou em tom de ironia: \"A intervenção que foi pedida, se feita, será feita com muito amor\".",
