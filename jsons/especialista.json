        {
          "instance_id": "FOLHA_DOC003172_SENT009::especialista::1",
          "sent_ID": "FOLHA_DOC003172_SENT009",
          "text": "Ex-sócia do banco BBM, especialista em gestão de risco, a economista deixou o setor privado para assumir a Secretaria Municipal de Fazenda do Rio em 2009.",
