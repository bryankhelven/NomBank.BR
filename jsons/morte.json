        {
          "instance_id": "FOLHA_DOC000092_SENT031::morte::1",
          "sent_ID": "FOLHA_DOC000092_SENT031",
          "text": "Tenho acompanhado, com tristeza, o noticiário sobre a lamentosa morte do professor Cancellier.",
