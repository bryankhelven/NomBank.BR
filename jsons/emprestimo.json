          "desc": "proprietário/emprestador",
          "definition": "Entidade que cede o bem para posterior devolução. Em empréstimos interinstitucionais agregados, o conjunto expresso pode abranger cedentes e recebedores, sem atribuir direção individual por ordem."
        },
        {
          "id": "Arg1",
          "desc": "bem emprestado",
          "definition": "Bem/quantia cedido."
        },
        {
          "id": "Arg2",
          "desc": "beneficiário",
          "definition": "Entidade que recebe o empréstimo, não finalidade genérica. Em empréstimos interinstitucionais agregados, o conjunto expresso pode abranger cedentes e recebedores, sem atribuir direção individual por ordem."
        },
        {
          "id": "Arg3",
          "desc": "garantia do empréstimo",
          "definition": "Bem/colateral efetivamente oferecido como garantia; sem garantia marca ausência, não bem realizado."
        },
        {
          "id": "Arg4",
          "desc": "juros ou taxa do empréstimo",
          "definition": "Taxa/juros explicitamente vinculados ao empréstimo, inclusive índice de juros médios com adaptação financeira."
        }
