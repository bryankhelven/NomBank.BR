        {
          "instance_id": "FOLHA_DOC003036_SENT008::liberdade::1",
          "sent_ID": "FOLHA_DOC003036_SENT008",
          "text": "Muita gente melhor que eu já denunciou o fechamento da exposição como violação da liberdade de expressão.",
