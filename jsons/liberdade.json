        {
          "instance_id": "FOLHA_DOC002030_SENT022::liberdade::1",
          "sent_ID": "FOLHA_DOC002030_SENT022",
          "text": "Fundamental a análise da Folha sobre o moralismo que cerceia a liberdade de expressão.",
          "arguments_annotated": false,
          "predicate": {
            "form": "liberdade",
            "char_start": 63,
            "char_end": 72
