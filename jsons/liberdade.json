        },
        {
          "instance_id": "FOLHA_DOC003055_SENT014::liberdade::1",
          "sent_ID": "FOLHA_DOC003055_SENT014",
          "text": "E a liberdade de expressão ou é valor absoluto, ou deixa de ser útil como pilar essencial da democracia.",
