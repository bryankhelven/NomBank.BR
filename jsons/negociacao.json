        {
          "instance_id": "FOLHA_DOC004082_SENT028::negociação::1",
          "sent_ID": "FOLHA_DOC004082_SENT028",
          "text": "Os repasses atrasados estão em negociação com as operadoras, e não deverão ser judicializados, afirma Balestrin.",
