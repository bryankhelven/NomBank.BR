        },
        {
          "instance_id": "FOLHA_DOC003185_SENT011::serviço::1",
          "sent_ID": "FOLHA_DOC003185_SENT011",
          "text": "Na hora de contratar o serviço, é importante avaliar quais as coberturas são de fato essenciais para aquela residência.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviço",
            "char_start": 23,
            "char_end": 30
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC003185_SENT021::serviço::1",
          "sent_ID": "FOLHA_DOC003185_SENT021",
          "text": "Inclui também assistência 24 horas com vários serviços -desde chaveiro até reparo de eletrodomésticos.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviços",
            "char_start": 46,
            "char_end": 54
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC003150_SENT036::serviço::1",
          "sent_ID": "FOLHA_DOC003150_SENT036",
          "text": "Guimarães cobra a partir de R$ 1.000 para criar um rótulo, serviço que consegue entregar em cerca de 20 dias.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviço",
            "char_start": 59,
            "char_end": 66
          },
          "realization": {},
          "syntax": {},
