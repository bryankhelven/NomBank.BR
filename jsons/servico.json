        },
        {
          "instance_id": "FOLHA_DOC002048_SENT018::serviço::1",
          "sent_ID": "FOLHA_DOC002048_SENT018",
          "text": "Mas quanto mais gente houver, mais claro ficará que os serviços públicos são ruins.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviços",
            "char_start": 55,
            "char_end": 63
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC000139_SENT022::serviço::1",
          "sent_ID": "FOLHA_DOC000139_SENT022",
          "text": "Foi um esforço para evitar um rombo nas contas que, no entanto, afetou serviços.",
          "arguments_annotated": false,
          "predicate": {
