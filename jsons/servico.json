        },
        {
          "instance_id": "FOLHA_DOC000161_SENT043::serviço::1",
          "sent_ID": "FOLHA_DOC000161_SENT043",
          "text": "Caso seja preciso trocá-los, o serviço custa a partir de R$ 100.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviço",
            "char_start": 31,
            "char_end": 38
          },
          "realization": {},
          "syntax": {},
