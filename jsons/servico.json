        },
        {
          "instance_id": "FOLHA_DOC002012_SENT013::serviço::1",
          "sent_ID": "FOLHA_DOC002012_SENT013",
          "text": "Os financistas costumavam acreditar que a regulamentação tornaria o mercado de serviços financeiros pouco atraente para novos rivais.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviços",
            "char_start": 79,
            "char_end": 87
          },
          "realization": {},
          "syntax": {},
