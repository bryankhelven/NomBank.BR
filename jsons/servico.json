        },
        {
          "instance_id": "FOLHA_DOC002038_SENT003::serviço::1",
          "sent_ID": "FOLHA_DOC002038_SENT003",
          "text": "Todos os serviços públicos estão sendo impactados por essa realidade, dado que os recursos de custeio e manutenção da máquina pública estão bastante escassos.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviços",
            "char_start": 9,
            "char_end": 17
          },
          "realization": {},
          "syntax": {},
