        {
          "instance_id": "FOLHA_DOC003166_SENT011::serviço::1",
          "sent_ID": "FOLHA_DOC003166_SENT011",
          "text": "Tornou-se praxe entre as seguradoras oferecer auxílio-residência, que inclui serviços como eletricista e encanador.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviços",
            "char_start": 77,
            "char_end": 85
          },
          "realization": {},
          "syntax": {},
