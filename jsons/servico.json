        },
        {
          "instance_id": "FOLHA_DOC004075_SENT008::serviço::1",
          "sent_ID": "FOLHA_DOC004075_SENT008",
          "text": "Quem ainda não teve a restituição liberada também pode verificar se há alguma pendência, por meio do serviço e-CAC.",
          "arguments_annotated": false,
          "predicate": {
            "form": "serviço",
            "char_start": 101,
