        },
        {
          "instance_id": "FOLHA_DOC003092_SENT006::general::1",
          "sent_ID": "FOLHA_DOC003092_SENT006",
          "text": "O general afirmou ainda: Então, se tiver que haver, haverá [ação militar].",
