        },
        {
          "instance_id": "FOLHA_DOC000018_SENT048::general::1",
          "sent_ID": "FOLHA_DOC000018_SENT048",
          "text": "Na cidade de Santa Cruz, Prado, 78 anos e hoje general aposentado, admitiu que o Exército estava mal preparado para o início de uma guerra de guerrilha em sua área.",
          "arguments_annotated": false,
          "predicate": {
