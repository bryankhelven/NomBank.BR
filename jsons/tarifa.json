        {
          "instance_id": "FOLHA_DOC003170_SENT005::tarifa::1",
          "sent_ID": "FOLHA_DOC003170_SENT005",
          "text": "E o governo dos EUA critica a decisão do Brasil de voltar a cobrar tarifa sobre o etanol americano.",
