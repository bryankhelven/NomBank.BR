        {
          "instance_id": "FOLHA_DOC003170_SENT011::tarifa::1",
          "sent_ID": "FOLHA_DOC003170_SENT011",
          "text": "Os produtores americanos de etanol de milho, que exportam para o Nordeste brasileiro, exortaram a Casa Branca a \"agir imediatamente e considerar todas as possibilidades para encorajar o Brasil\" a revogar a tarifa.",
          "arguments_annotated": false,
          "predicate": {
