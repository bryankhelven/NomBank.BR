        {
          "instance_id": "FOLHA_DOC003161_SENT004::tarifa::1",
          "sent_ID": "FOLHA_DOC003161_SENT004",
          "text": "Em termos percentuais, essa diferença pode chegar a 379% entre a tarifa mais barata e a mais cara nos casos mais extremos.",
