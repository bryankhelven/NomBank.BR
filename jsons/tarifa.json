        {
          "instance_id": "FOLHA_DOC003170_SENT012::tarifa::1",
          "sent_ID": "FOLHA_DOC003170_SENT012",
          "text": "Os dois países haviam eliminado suas tarifas sobre etanol por meio de um acordo em 2010.",
