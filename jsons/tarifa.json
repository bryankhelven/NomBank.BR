        {
          "instance_id": "FOLHA_DOC003161_SENT032::tarifa::1",
          "sent_ID": "FOLHA_DOC003161_SENT032",
          "text": "Procurada pela reportagem, a Azul afirmou, através de nota enviada por sua assessoria de comunicação, que as tarifas praticadas pela empresa são determinadas por diferentes variáveis.",
          "arguments_annotated": true,
