          "instance_id": "FOLHA_DOC002010_SENT019::mandato::1",
          "sent_ID": "FOLHA_DOC002010_SENT019",
          "text": "Com o quarto mandato, que garantiu neste domingo (24), ela deve chegar aos 16 anos de poder.",
          "arguments_annotated": false,
          "predicate": {
