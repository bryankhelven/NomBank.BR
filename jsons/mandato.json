        {
          "instance_id": "FOLHA_DOC001710_SENT009::mandato::1",
          "sent_ID": "FOLHA_DOC001710_SENT009",
          "text": "Ao votar, Fux disse que Aécio não teve \"grandeza\" por não ter se afastado voluntariamente do mandato.",
