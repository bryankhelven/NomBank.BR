        {
          "instance_id": "FOLHA_DOC000152_SENT008::mandato::1",
          "sent_ID": "FOLHA_DOC000152_SENT008",
          "text": "Nesse encontro, encerra-se oficialmente o mandato do senador Aécio Neves.",
          "arguments_annotated": false,
          "predicate": {
            "form": "mandato",
            "char_start": 42,
