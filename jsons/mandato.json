          "predicate": {
            "form": "mandato",
            "char_start": 140,
            "char_end": 147
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC003006_SENT006::mandato::1",
          "sent_ID": "FOLHA_DOC003006_SENT006",
          "text": "As decisões decorrentes de uma reforma política têm impacto nos mandatos e, portanto, afetam diretamente os parlamentares que estão tratando da questão.",
