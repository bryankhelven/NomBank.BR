        },
        {
          "instance_id": "FOLHA_DOC000108_SENT017::mandato::1",
          "sent_ID": "FOLHA_DOC000108_SENT017",
          "text": "Lula, com cinco candidaturas presidenciais e dois mandatos no Planalto, lidera as intenções de voto.",
