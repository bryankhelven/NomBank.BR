        {
          "instance_id": "FOLHA_DOC002032_SENT005::mandato::1",
          "sent_ID": "FOLHA_DOC002032_SENT005",
          "text": "Anastasia tem ainda quatro anos de mandato no Senado e, se eleito, teria que administrar um Estado com deficit previsto até 2019.",
          "arguments_annotated": false,
          "predicate": {
            "form": "mandato",
            "char_start": 35,
            "char_end": 42
          },
          "realization": {},
          "syntax": {},
