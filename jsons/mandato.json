        {
          "instance_id": "FOLHA_DOC003141_SENT017::mandato::1",
          "sent_ID": "FOLHA_DOC003141_SENT017",
          "text": "Ele acredita que o presidente deveria ter enviado ao Congresso o projeto que estabelece novas regras de aposentadoria logo no início de seu mandato.",
          "arguments_annotated": false,
          "predicate": {
            "form": "mandato",
            "char_start": 140,
            "char_end": 147
          },
          "realization": {},
          "syntax": {},
