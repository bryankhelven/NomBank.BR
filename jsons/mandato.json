        {
          "instance_id": "FOLHA_DOC000139_SENT021::mandato::1",
          "sent_ID": "FOLHA_DOC000139_SENT021",
          "text": "No fim do mandato, em 2016, a gestão Haddad reduziu gastos em várias áreas.",
