        {
          "instance_id": "FOLHA_DOC001786_SENT011::mandato::1",
          "sent_ID": "FOLHA_DOC001786_SENT011",
          "text": "A Constituição tem um dispositivo que determina que um parlamentar em exercício do mandato só pode ser preso em caso de flagrante.",
