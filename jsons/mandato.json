        },
        {
          "instance_id": "FOLHA_DOC000020_SENT026::mandato::1",
          "sent_ID": "FOLHA_DOC000020_SENT026",
          "text": "O senador tucano se recusou a comentar turbulências recentes envolvendo o PSDB, como a guerra virtual entre Alberto Goldman e João Doria e a decisão do STF de afastar o senador Aécio Neves de seu mandato.",
          "arguments_annotated": false,
          "predicate": {
            "form": "mandato",
            "char_start": 196,
            "char_end": 203
          },
          "realization": {},
          "syntax": {},
