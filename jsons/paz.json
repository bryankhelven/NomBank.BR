        {
          "instance_id": "FOLHA_DOC003003_SENT006::paz::1",
          "sent_ID": "FOLHA_DOC003003_SENT006",
          "text": "Antes, dezenas de pessoas marcharam pacificamente até o centro da cidade entoando palavras de ordem como \"parem de nos matar\" e \"sem justiça, sem paz\".",
          "arguments_annotated": false,
          "predicate": {
