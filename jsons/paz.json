        },
        {
          "instance_id": "FOLHA_DOC000123_SENT001::paz::1",
          "sent_ID": "FOLHA_DOC000123_SENT001",
          "text": "Ao lado de Capitão América e Prem Baba, Doria deseja 'paz' a Goldman.",
          "arguments_annotated": false,
          "predicate": {
            "form": "paz",
            "char_start": 54,
