        },
        {
          "instance_id": "FOLHA_DOC000092_SENT021::paz::1",
          "sent_ID": "FOLHA_DOC000092_SENT021",
          "text": "Todos cantarão vitória e a paz reinará até o próximo arroubo nacionalista.",
          "arguments_annotated": false,
          "predicate": {
            "form": "paz",
            "char_start": 27,
