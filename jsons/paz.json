        },
        {
          "instance_id": "FOLHA_DOC003140_SENT065::paz::1",
          "sent_ID": "FOLHA_DOC003140_SENT065",
          "text": "Os mais antigos eram construídos com a perspectiva de manutenção da paz, para conter conflitos ou reforçar as fronteiras.",
          "arguments_annotated": false,
          "predicate": {
            "form": "paz",
