        {
          "instance_id": "FOLHA_DOC004015_SENT012::paz::1",
          "sent_ID": "FOLHA_DOC004015_SENT012",
          "text": "De toda maneira, embora a paz seja em tese alcançável, são muitos os obstáculos para obtê-la.",
          "arguments_annotated": false,
          "predicate": {
            "form": "paz",
