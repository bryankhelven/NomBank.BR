        {
          "instance_id": "FOLHA_DOC003289_SENT012::paz::1",
          "sent_ID": "FOLHA_DOC003289_SENT012",
          "text": "Eles gritavam palavras de ordem como \"sem justiça, sem paz\" e chamavam Stockley de assassino.",
          "arguments_annotated": false,
          "predicate": {
            "form": "paz",
            "char_start": 55,
