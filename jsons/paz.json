        {
          "instance_id": "FOLHA_DOC002014_SENT005::paz::1",
          "sent_ID": "FOLHA_DOC002014_SENT005",
          "text": "Mourão, é claro, mente para seu público que não é Rogério 157, que é o Exército subindo a Rocinha para garantir a paz.",
          "arguments_annotated": false,
          "predicate": {
            "form": "paz",
