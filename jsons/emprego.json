        {
          "instance_id": "FOLHA_DOC001143_SENT009::emprego::1",
          "sent_ID": "FOLHA_DOC001143_SENT009",
          "text": "Sempre fico surpreso quando as pessoas me falam que em 2050 47,3% dos empregos atuais não existirão.",
