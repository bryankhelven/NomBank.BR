        {
          "instance_id": "FOLHA_DOC003185_SENT009::cobertura::1",
          "sent_ID": "FOLHA_DOC003185_SENT009",
          "text": "Mas as seguradoras oferecem uma infinidade de coberturas adicionais, que variam de acordo com a necessidade de cada cliente.",
          "arguments_annotated": false,
          "predicate": {
            "form": "coberturas",
