        {
          "instance_id": "FOLHA_DOC000170_SENT009::atenção::1",
          "sent_ID": "FOLHA_DOC000170_SENT009",
          "text": "O livro não tem exatamente um protagonista, um herói que conduza a história e concentre atenções.",
