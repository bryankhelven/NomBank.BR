          "predicate": {
            "form": "vida",
            "char_start": 8,
            "char_end": 12
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC003202_SENT033::vida::1",
          "sent_ID": "FOLHA_DOC003202_SENT033",
          "text": "Atala mora no Sumaré, na zona oeste paulistana, e conta que um clássico dia de folga na vida dele é um domingão.",
          "arguments_annotated": false,
          "predicate": {
            "form": "vida",
            "char_start": 88,
            "char_end": 92
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC003182_SENT006::vida::1",
          "sent_ID": "FOLHA_DOC003182_SENT006",
          "text": "Amo tecnologia e quero criar coisas que possam melhorar a vida das pessoas, não necessariamente mudar a humanidade, mas fazer algo que facilite o dia a dia, que atenda a uma necessidade.",
          "arguments_annotated": false,
          "predicate": {
