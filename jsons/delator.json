        {
          "instance_id": "FOLHA_DOC003035_SENT122::delator::1",
          "sent_ID": "FOLHA_DOC003035_SENT122",
          "text": "O que eu estava dizendo é que o cliente dele [a JBS] poderia passar de candidato a delator a delatado.",
