        {
          "instance_id": "FOLHA_DOC004042_SENT019::delator::1",
          "sent_ID": "FOLHA_DOC004042_SENT019",
          "text": "Conforme antecipou a Folha, Janot pretende rever a imunidade concedida aos delatores.",
