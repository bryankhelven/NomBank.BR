        },
        {
          "instance_id": "FOLHA_DOC003052_SENT005::direção::1",
          "sent_ID": "FOLHA_DOC003052_SENT005",
          "text": "Thandie Newton (\"Westworld\"), 44, e Padma Lakshmi, 47, foram na mesma direção rosácea pasteurizada.",
          "arguments_annotated": false,
          "predicate": {
            "form": "direção",
            "char_start": 70,
            "char_end": 77
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC003020_SENT019::direção::1",
          "sent_ID": "FOLHA_DOC003020_SENT019",
          "text": "O governo vem politizando os furacões, só que na direção contrária, fingindo que não há relação com aquecimento global, diz Robert Richardson, outro cientista demitido.",
          "arguments_annotated": false,
          "predicate": {
            "form": "direção",
            "char_start": 49,
            "char_end": 56
          },
          "realization": {},
          "syntax": {},
          "argument_positions": {}
        },
        {
          "instance_id": "FOLHA_DOC001823_SENT027::direção::1",
          "sent_ID": "FOLHA_DOC001823_SENT027",
          "text": "Vimos que cada um estava indo numa direção.",
          "arguments_annotated": false,
          "predicate": {
            "form": "direção",
            "char_start": 35,
            "char_end": 42
          },
          "realization": {},
          "syntax": {},
