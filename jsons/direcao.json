        {
          "instance_id": "FOLHA_DOC002017_SENT027::direção::1",
          "sent_ID": "FOLHA_DOC002017_SENT027",
          "text": "Nem o Banco Central nem a CVM (Comissão de Valores Mobiliários) deram passos nessa direção.",
          "arguments_annotated": false,
          "predicate": {
            "form": "direção",
            "char_start": 83,
