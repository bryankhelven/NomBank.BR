        },
        {
          "instance_id": "FOLHA_DOC004054_SENT005::direção::1",
          "sent_ID": "FOLHA_DOC004054_SENT005",
          "text": "Quem pretende seguir em direção ao Capão Redondo precisa descer na Adolfo Pinheiro e pagar a passagem.",
          "arguments_annotated": false,
          "predicate": {
            "form": "direção",
            "char_start": 24,
            "char_end": 31
          },
          "realization": {},
          "syntax": {},
