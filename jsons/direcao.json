        {
          "instance_id": 8635,
          "sent_ID": "FOLHA_DOC003052_SENT005",
          "text": "Thandie Newton (\"Westworld\"), 44, e Padma Lakshmi, 47, foram na mesma direção rosácea pasteurizada.",
