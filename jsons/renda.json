        {
          "instance_id": "FOLHA_DOC000023_SENT011::renda::1",
          "sent_ID": "FOLHA_DOC000023_SENT011",
          "text": "Os private, que são pessoas físicas de alta renda, respondiam por R$ 61,4 bilhões (27,8%).",
