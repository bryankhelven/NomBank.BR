        {
          "instance_id": "FOLHA_DOC003144_SENT002::renda::1",
          "sent_ID": "FOLHA_DOC003144_SENT002",
          "text": "Estudo de Marc Morgan, do World Wealth and Income Database, instituto de pesquisa codirigido pelo economista Thomas Piketty, mostra que a desigualdade de renda no Brasil não caiu entre 2001 e 2015.",
          "arguments_annotated": true,
