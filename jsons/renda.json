        {
          "instance_id": "FOLHA_DOC003118_SENT023::renda::1",
          "sent_ID": "FOLHA_DOC003118_SENT023",
          "text": "Eles usaram dados do Censo de 2010 e simularam qual seria o índice de Gini (indicador de distribuição de renda) caso os casamentos tivessem as mesmas características de heterogeneidade de 1970.",
          "arguments_annotated": true,
