        {
          "instance_id": "FOLHA_DOC002041_SENT006::discussão::1",
          "sent_ID": "FOLHA_DOC002041_SENT006",
          "text": "Sempre que se fala em reforma tributária, surge a discussão sobre quem vai pagar a conta.",
