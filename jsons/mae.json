        {
          "instance_id": "FOLHA_DOC003108_SENT003::mãe::1",
          "sent_ID": "FOLHA_DOC003108_SENT003",
          "text": "Margot Robbie tem colhido elogios por sua performance como a controversa patinadora Tonya Harding em \"I, Tonya\", e Frances McDormand por sua mãe justiceira em \"Thee Billboards Outisde Ebbing, Missouri\".",
