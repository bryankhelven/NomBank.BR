        {
          "instance_id": "FOLHA_DOC003182_SENT011::mãe::1",
          "sent_ID": "FOLHA_DOC003182_SENT011",
          "text": "A minha mãe [Ana Paula Lima, 42] me influenciou a buscar pelos meus desejos, a enfrentar a vida desde muito cedo.",
