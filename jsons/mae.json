        {
          "instance_id": "FOLHA_DOC001048_SENT014::mãe::1",
          "sent_ID": "FOLHA_DOC001048_SENT014",
          "text": "O mesmo vale para quem se escandaliza com o seio de uma mãe que amamenta.",
