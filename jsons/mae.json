        {
          "instance_id": "FOLHA_DOC001046_SENT008::mãe::1",
          "sent_ID": "FOLHA_DOC001046_SENT008",
          "text": "Foi com o irmão mais novo, de 9 anos, para o quarto da mãe e do padrasto.",
