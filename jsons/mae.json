        {
          "instance_id": "FOLHA_DOC003014_SENT020::mãe::1",
          "sent_ID": "FOLHA_DOC003014_SENT020",
          "text": "\"Basquete é o jogo de que eu mais gosto\", diz ele, que saiu de Niterói com a mãe, Larissa, e a tia, Lorena, para conhecer o festival.",
          "arguments_annotated": true,
          "predicate": {
