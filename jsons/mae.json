        {
          "instance_id": "FOLHA_DOC003109_SENT031::mãe::1",
          "sent_ID": "FOLHA_DOC003109_SENT031",
          "text": "Você fica pensando mil e uma coisas do que vai acontecer, disse Zilda Maria de Paula, 65, mãe do pintor Fernando de Paula, 34.",
