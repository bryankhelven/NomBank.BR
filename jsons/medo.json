        {
          "instance_id": "FOLHA_DOC001769_SENT012::medo::1",
          "sent_ID": "FOLHA_DOC001769_SENT012",
          "text": "Turistas, curiosos e clientes do asfalto aos poucos perderam o medo de circular por suas vielas.",
