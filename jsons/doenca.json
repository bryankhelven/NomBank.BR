        {
          "instance_id": "FOLHA_DOC000041_SENT048::doença::1",
          "sent_ID": "FOLHA_DOC000041_SENT048",
          "text": "As mulheres, em sua maioria, estão sozinhas enfrentando suas doenças, conta Katia.",
          "arguments_annotated": true,
