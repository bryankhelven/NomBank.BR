        {
          "instance_id": "FOLHA_DOC001274_SENT007::sistema::1",
          "sent_ID": "FOLHA_DOC001274_SENT007",
          "text": "Ilustra bem como funciona o sistema descentralizado de gestão escolar no Estado.",
