        {
          "instance_id": "FOLHA_DOC003240_SENT018::sistema::1",
          "sent_ID": "FOLHA_DOC003240_SENT018",
          "text": "No mundo já há experiências de sistemas na Europa, Austrália, Califórnia e outros.",
