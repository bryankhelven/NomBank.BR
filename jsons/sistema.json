        },
        {
          "instance_id": "FOLHA_DOC004073_SENT010::sistema::1",
          "sent_ID": "FOLHA_DOC004073_SENT010",
          "text": "Já no sistema distrital misto, apenas uma parte, digamos a metade, dos deputados seria eleita por tais votos diretos.",
          "arguments_annotated": true,
          "predicate": {
