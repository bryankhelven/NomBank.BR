        },
        {
          "instance_id": "FOLHA_DOC002041_SENT040::sistema::1",
          "sent_ID": "FOLHA_DOC002041_SENT040",
          "text": "Esses outros meios de transporte não são interpretados como veículos automotores pelo nosso sistema.",
