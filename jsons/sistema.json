        {
          "instance_id": "FOLHA_DOC002012_SENT005::sistema::1",
          "sent_ID": "FOLHA_DOC002012_SENT005",
          "text": "Nos bastidores, há crescente inquietação quanto ao grau de desordenamento que a tecnologia pode causar nos bancos e no sistema de pagamentos.",
          "arguments_annotated": true,
          "predicate": {
