        },
        {
          "instance_id": "FOLHA_DOC002045_SENT017::sistema::1",
          "sent_ID": "FOLHA_DOC002045_SENT017",
          "text": "O sistema público já conta com um modelo consagrado para o trabalho de prevenção.",
