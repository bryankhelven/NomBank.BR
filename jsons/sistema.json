        {
          "instance_id": "FOLHA_DOC000103_SENT006::sistema::1",
          "sent_ID": "FOLHA_DOC000103_SENT006",
          "text": "Para ele, há muito desperdício no sistema de saúde por fraudes, falta de informações e processos.",
